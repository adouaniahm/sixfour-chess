CODE_SIGN_STYLE = Manual
"CODE_SIGN_IDENTITY[sdk=iphoneos*]" = "Apple Distribution"
"PROVISIONING_PROFILE_SPECIFIER[sdk=iphoneos*]" = "Your provisioning profile name"
